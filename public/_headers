# Cloudflare static assets: how long browsers and the edge may keep files.
# Built code has a content hash in its name, so it never changes: keep it for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Film frames, stills and art kits: kept a day, then refreshed in the background, so a guest never
# waits on a check before the film can move (a re-rendered film shows within a day).
/kits/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
