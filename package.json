{
    "name": "toran",
    "private": true,
    "type": "module",
    "description": "Toran by Rigi — digital invitations & celebration experiences",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 5173",
        "dev:node": "PLATFORM=node vite dev --port 5174",
        "build": "vite build",
        "build:node": "PLATFORM=node vite build",
        "start:node": "node --import tsx server/node-serve.ts",
        "preview": "npm run build && vite preview",
        "deploy": "npm run build && wrangler deploy",
        "check:size": "npm run build && wrangler deploy --dry-run",
        "cf-typegen": "wrangler types",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "format": "eslint . --fix; prettier --write .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "db:generate": "drizzle-kit generate",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
        "db:seed:local": "tsx scripts/seed.ts",
        "db:seed:remote": "tsx scripts/seed.ts --remote",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,mjs}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.{json,css}": "prettier --write"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@fontsource-variable/cormorant-garamond": "^5.3.0",
        "@fontsource-variable/fraunces": "^5.3.0",
        "@fontsource-variable/manrope": "^5.3.0",
        "@fontsource-variable/noto-nastaliq-urdu": "^5.3.0",
        "@fontsource-variable/noto-sans-gurmukhi": "^5.3.0",
        "@fontsource-variable/noto-serif-devanagari": "^5.3.0",
        "@fontsource-variable/noto-serif-gujarati": "^5.3.0",
        "@fontsource-variable/noto-serif-hebrew": "^5.3.0",
        "@fontsource-variable/reem-kufi": "^5.3.0",
        "@fontsource/amiri": "^5.3.0",
        "@fontsource/aref-ruqaa": "^5.3.0",
        "@fontsource/cinzel": "^5.3.0",
        "@fontsource/marcellus": "^5.3.0",
        "@fontsource/pinyon-script": "^5.3.0",
        "@hono/node-server": "^2.1.7",
        "@libsql/client": "^0.18.0",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-router-ssr-query": "^1.167.3",
        "@tanstack/react-start": "^1.169.5",
        "@tanstack/react-table": "^8.21.3",
        "aws4fetch": "^1.0.20",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "drizzle-orm": "^0.45.4",
        "gsap": "^3.15.1",
        "hono": "^4.13.18",
        "input-otp": "^1.5.0",
        "lenis": "^1.3.27",
        "lucide-react": "^1.72.0",
        "motion": "^14.12.0",
        "nanoid": "^6.0.2",
        "ogl": "^1.0.11",
        "radix-ui": "^1.8.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "recharts": "^3.8.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "uqr": "^0.1.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.68.0",
        "@eslint/js": "^10.0.1",
        "@inlang/paraglide-js": "^3.2.2",
        "@inlang/plugin-message-format": "^4.6.0",
        "@playwright/test": "^1.65.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.3.5",
        "@tanstack/eslint-plugin-query": "^5.107.1",
        "@tanstack/eslint-plugin-router": "^1.162.0",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.10.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "typescript": "~6.0",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.3.8",
        "vitest": "^5.1.0",
        "wrangler": "^4.160.0"
    }
}
