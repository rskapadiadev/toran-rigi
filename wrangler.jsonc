{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "toran",
    "main": "./src/server.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    "upload_source_maps": true,
    "d1_databases": [
        {
            // `npm run dev` uses a local copy; only --remote commands and deploys touch this database.
            "binding": "DB",
            "database_name": "toran",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "toran-media" }],
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 60 },
        },
    ],
    "triggers": { "crons": ["*/15 * * * *", "30 3 * * *"] },
    "vars": {
        "ENVIRONMENT": "development",
        "PARENT_DOMAIN": "therigi.co",
        "APP_HOST": "toran.therigi.co",
        "APP_ORIGIN": "http://localhost:5173",
        "INVITE_URL_MODE": "path",
    },
    // Production: "routes": [{ "pattern": "toran.therigi.co", "custom_domain": true }]
}
