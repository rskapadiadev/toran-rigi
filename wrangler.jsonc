{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "toran",
    "main": "./src/server.ts",
    "compatibility_date": "2026-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "observability": { "enabled": true },
    "upload_source_maps": true,
    "d1_databases": [
        {
            // `npm run dev` uses a local copy; only --remote commands and deploys touch this database.
            "binding": "DB",
            "database_name": "toran",
            "database_id": "00000000-0000-0000-0000-000000000000",
            "migrations_dir": "migrations",
        },
    ],
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "toran-media" }],
    // The app's own files (public/), read by the Worker when it must cut byte ranges from one.
    "assets": { "binding": "ASSETS" },
    // Browser Rendering: photographs invitations page by page for their PDF.
    "browser": { "binding": "BROWSER" },
    "ratelimits": [
        {
            "name": "RATE_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 30, "period": 60 },
        },
    ],
    "triggers": { "crons": ["*/15 * * * *", "30 3 * * *"] },
    "vars": {
        "ENVIRONMENT": "development",
        "PARENT_DOMAIN": "therigi.co",
        "APP_HOST": "toran.therigi.co",
        "APP_ORIGIN": "http://localhost:5173",
        "INVITE_URL_MODE": "path",
    },
    // Live site: build and deploy with `npm run deploy:prod` (CLOUDFLARE_ENV=production).
    // Bindings are not inherited by environments, so each one is listed again here.
    "env": {
        "production": {
            // Same name as the top level. The workers.dev address stays on so links already shared keep working.
            "name": "toran",
            "workers_dev": true,
            // Its own domain: Cloudflare serves it from the guest's nearest data centre, where the shared
            // workers.dev address sent India through Singapore (0.5-2 s before each file's first byte).
            "routes": [{ "pattern": "toran.therigi.shop", "custom_domain": true }],
            // Workers Cache: Cloudflare answers repeat requests for cacheable responses (posters,
            // photos, music under /media; share images) at the edge without running the Worker or
            // reading R2. Everything else is marked private, no-store in server/app.ts.
            "cache": { "enabled": true },
            "d1_databases": [
                {
                    "binding": "DB",
                    "database_name": "toran",
                    "database_id": "5b849354-99f4-423e-a81e-af2d1b9c46ac",
                    "migrations_dir": "migrations",
                },
            ],
            "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "toran-media" }],
            "assets": { "binding": "ASSETS" },
            "browser": { "binding": "BROWSER" },
            "ratelimits": [
                {
                    "name": "RATE_LIMITER",
                    "namespace_id": "1001",
                    "simple": { "limit": 30, "period": 60 },
                },
            ],
            "triggers": { "crons": ["*/15 * * * *", "30 3 * * *"] },
            // Secrets (SESSION_SECRET, RESEND_API_KEY, PIXABAY_API_KEY, CLOUDFLARE_AI_TOKEN…) are set
            // with `npx wrangler secret put NAME --env production`, never written here.
            "vars": {
                "ENVIRONMENT": "production",
                "PARENT_DOMAIN": "therigi.shop",
                "APP_HOST": "toran.therigi.shop",
                "APP_ORIGIN": "https://toran.therigi.shop",
                "INVITE_URL_MODE": "path",
                "MAILER_DRIVER": "resend",
                // therigi.shop is verified in Resend (DKIM and the send. subdomain are in Cloudflare DNS).
                // An unverified domain here makes Resend reject every email, sign-in codes included.
                "MAIL_FROM": "Toran <hello@therigi.shop>",
                // Online payment is not live yet: orders are saved unpaid (see server/api/store.ts).
                "PAYMENTS_DRIVER": "fake",
            },
        },
    },
}
